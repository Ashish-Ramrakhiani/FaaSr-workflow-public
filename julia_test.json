{
  "ActionList": {
    "solve": {
      "FunctionName": "solveSIRModel",
      "FaaSServer": "GH",
      "InvokeNext": ["processData"],
      "Type": "Julia"
    },
    "getData": {
      "FunctionName": "getSIRData",
      "FaaSServer": "GH",
      "InvokeNext": ["solve"],
      "Type": "Python"
    },
    "processData": {
      "FunctionName": "processSIRData",
      "FaaSServer": "GH",
      "InvokeNext": [],
